# Copy to .env on the server. Do not commit real credentials.
PORT=3000
NODE_ENV=production
JWT_SECRET=
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
# Exact trusted browser origin. Never use *.
ALLOWED_ORIGINS=https://haxpassword-production.up.railway.app
# Optional persistent path supplied by your hosting provider.
DATA_FILE=
