# Copy to .env on the server. Do not commit real credentials.
PORT=3000
NODE_ENV=production
JWT_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_OF_14_OR_MORE_CHARACTERS
# Configure only when the frontend is hosted on another origin.
ALLOWED_ORIGINS=
# Optional persistent path supplied by your hosting provider.
DATA_FILE=
